table fact_complaints
	lineageTag: e8f7d1ce-e789-583d-99a4-f4bb912cd0d9
	sourceLineageTag: [dbo].[fact_complaints]

	/// Customer complaints received.
	measure Complaints = COUNTROWS ( fact_complaints )
		formatString: #,0
		displayFolder: Quality
		lineageTag: 3e9a1ca5-f316-5df0-b4f2-cf9035d07a34

	/// Complaints per delivered order line.
	measure 'Complaint Rate %' = DIVIDE ( [Complaints], [Delivered Lines] )
		formatString: 0.00%
		displayFolder: Quality
		lineageTag: 204ab37c-586f-5464-9295-44ebaaf99083

