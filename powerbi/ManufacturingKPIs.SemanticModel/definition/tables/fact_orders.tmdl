table fact_orders
	lineageTag: 18f2cfa5-67c3-5a71-81f3-5432b9e5ea8f
	sourceLineageTag: [dbo].[fact_orders]

	/// Number of order lines after cleaning.
	measure 'Order Lines' = COUNTROWS ( fact_orders )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 7d6611d3-d65b-586a-85bb-0385df3175b0

	/// Net order value in EUR.
	measure 'Net Sales EUR' = SUM ( fact_orders[net_value_eur] )
		formatString: #,0.00
		displayFolder: Delivery
		lineageTag: 91d1a438-b650-5e38-876f-3f2b6f5b3b39

	/// Order lines with a delivery date.
	measure 'Delivered Lines' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 6b8f318d-0543-5449-bef0-25f08ac5edc7

	/// Delivered lines with delivered_date on or before requested_date.
	measure 'On-Time Lines' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_on_time] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: c0f7d133-a65d-50e1-91fe-f0b60b8175e0

	/// Share of delivered order lines that arrived on or before the requested date.
	measure 'On-Time Delivery %' = DIVIDE ( [On-Time Lines], [Delivered Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 4ca08cc0-dce8-5ce9-810c-61e92e1eb77c

