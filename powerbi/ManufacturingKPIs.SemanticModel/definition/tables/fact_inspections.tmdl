table fact_inspections
	lineageTag: 6d55f747-70db-5912-b524-d2abcc5bd35a
	sourceLineageTag: [dbo].[fact_inspections]

	/// Share of in-process inspections with result PASS.
	measure 'Inspection Pass Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_inspections ), fact_inspections[is_pass] = TRUE () ), COUNTROWS ( fact_inspections ) )
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 467332d1-83e7-5805-a442-9cade8db6bff

