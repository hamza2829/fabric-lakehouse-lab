table fact_production
	lineageTag: b6f4bc90-a7b6-5e05-a79f-94f5995fcd10
	sourceLineageTag: [dbo].[fact_production]

	/// Units produced over all machine runs.
	measure 'Units Produced' = SUM ( fact_production[units_produced] )
		formatString: #,0
		displayFolder: Production
		lineageTag: edf49467-c614-56ab-bbbc-970e4b669984

	/// Scrapped units; scrap booked in KG is converted to pieces in silver.
	measure 'Scrap Units' = SUM ( fact_production[scrap_units] )
		formatString: #,0
		displayFolder: Production
		lineageTag: f926cb03-4b3e-5aab-8dcd-45c945a0a456

	/// Scrapped units divided by units produced.
	measure 'Scrap Rate %' = DIVIDE ( [Scrap Units], [Units Produced] )
		formatString: 0.00%
		displayFolder: Production
		lineageTag: b54d4a4d-0984-5376-8226-06b617d79062

	/// Run time divided by planned production time.
	measure 'Availability %' = DIVIDE ( SUM ( fact_production[run_time_min] ), SUM ( fact_production[planned_runtime_min] ) )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: 96babdf3-f498-5c3b-8702-826d6d2bcb4d

	/// Ideal cycle time x units produced, divided by run time.
	measure 'Performance %' = DIVIDE ( SUM ( fact_production[ideal_run_time_min] ), SUM ( fact_production[run_time_min] ) )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: d2c0df38-0c13-5002-be6b-f4691f7d5736

	/// Good units divided by units produced.
	measure 'Quality Rate %' = DIVIDE ( SUM ( fact_production[good_units] ), [Units Produced] )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: 7d3697ec-cce8-5a3a-8d7b-7e776293b811

	/// Availability x Performance x Quality rate.
	measure 'OEE %' =
			VAR _availability = [Availability %]
			VAR _performance = [Performance %]
			VAR _quality = [Quality Rate %]
			RETURN
			    _availability * _performance * _quality
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: 47c9e8a0-c2ff-552e-b324-7ac3e6a85b6c

