                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "year_month"
                }
              },
              "queryRef": "dim_date.year_month",
              "nativeQueryRef": "year_month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_production"
                    }
                  },
                  "Property": "Scrap Rate %"
                }
              },
              "queryRef": "fact_production.Scrap Rate %",
              "nativeQueryRef": "Scrap Rate %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_inspections"
                    }
                  },
                  "Property": "Inspection Pass Rate %"
                }
              },
              "queryRef": "fact_inspections.Inspection Pass Rate %",
              "nativeQueryRef": "Inspection Pass Rate %"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
