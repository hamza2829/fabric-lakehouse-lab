{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "production_04_clusteredBarChart",
  "position": {
    "x": 20,
    "y": 160,
    "z": 4,
    "width": 620,
    "height": 540,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_machine"
                    }
                  },
                  "Property": "machine_name"
                }
              },
              "queryRef": "dim_machine.machine_name",
              "nativeQueryRef": "machine_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_production"
                    }
                  },
                  "Property": "OEE %"
                }
              },
              "queryRef": "fact_production.OEE %",
              "nativeQueryRef": "OEE %"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
